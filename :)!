        if (stored == null || stored.isEmpty()) {
            renderSignedOut();
            return;
        }

        try {
            JSONObject saved = new JSONObject(stored);
            String refreshToken = saved.getString("refreshToken");
            String uid = saved.optString("uid", "");
            String email = saved.optString("email", "");
            String displayName = saved.optString("displayName", "Conta Google");
            setBusy(true, "Verificando sua sessão DVNex…");

            networkExecutor.execute(() -> {
                try {
                    JSONObject refreshed = refreshFirebaseToken(refreshToken);
                    String newIdToken = refreshed.getString("id_token");
                    String newRefreshToken = refreshed.optString("refresh_token", refreshToken);
                    String refreshedUid = refreshed.optString("user_id", uid);

                    JSONObject updated = new JSONObject();
                    updated.put("refreshToken", newRefreshToken);
                    updated.put("uid", refreshedUid);
                    updated.put("email", email);
                    updated.put("displayName", displayName);
                    sessionStore.write(updated.toString());
                    String profileSyncMessage = syncProfileSafely(newIdToken, refreshedUid, email, displayName);
                    final String finalProfileSyncMessage = profileSyncMessage;

                    mainHandler.post(() -> {
                        if (isFinishing() || isDestroyed()) return;
                        currentIdToken = newIdToken;
                        renderSignedIn(refreshedUid, email, displayName);
                        statusView.append("\n" + finalProfileSyncMessage);
                    });
                } catch (Exception e) {
                    final String message = safeMessage(e);
                    boolean invalidSession = isInvalidRefreshTokenError(message);
                    if (invalidSession) sessionStore.clear();
                    mainHandler.post(() -> {
                        if (isFinishing() || isDestroyed()) return;
                        currentIdToken = null;
                        renderSignedOut();
                        if (invalidSession) {
                            statusView.setText("Sua sessão expirou. Entre novamente.");
                        } else {
                            showError("Não foi possível verificar a sessão. Confira sua conexão e tente novamente. "
                                    + message);
                        }
                    });
                }
            });
        } catch (Exception e) {
            sessionStore.clear();
            renderSignedOut();
            showError("A sessão salva estava inválida. Entre novamente.");
        }
    }

    /** Writes only the profile fields for the authenticated UID; Firestore Security Rules authorize the write. */
    private String syncProfileSafely(String idToken, String uid, String email, String displayName) {
        try {
            writeProfileToFirestore(idToken, uid, email, displayName);
            return "Perfil DVNex salvo no Cloud Firestore.";
        } catch (Exception e) {
            return "Login concluido, mas o perfil nao foi sincronizado: " + safeMessage(e);
        }
    }

    private void writeProfileToFirestore(String idToken, String uid, String email, String displayName) throws Exception {
        if (idToken == null || idToken.isEmpty()) throw new IllegalStateException("FIREBASE_ID_TOKEN_AUSENTE");
        if (uid == null || uid.isEmpty()) throw new IllegalStateException("FIREBASE_UID_AUSENTE");
        if (projectId == null || projectId.isEmpty()) throw new IllegalStateException("FIREBASE_PROJECT_ID_AUSENTE");

        JSONObject fields = new JSONObject();
        fields.put("uid", new JSONObject().put("stringValue", uid));
        fields.put("email", new JSONObject().put("stringValue", email == null ? "" : email));
        fields.put("displayName", new JSONObject().put("stringValue", displayName == null ? "" : displayName));
        fields.put("provider", new JSONObject().put("stringValue", "google.com"));
        fields.put("lastLoginAt", new JSONObject().put("timestampValue", java.time.Instant.now().toString()));

        JSONObject document = new JSONObject();
        document.put("fields", fields);

        String encodedProject = urlEncode(projectId);
        String encodedUid = urlEncode(uid);
        String endpoint = "https://firestore.googleapis.com/v1/projects/" + encodedProject
                + "/databases/(default)/documents/users/" + encodedUid
                + "?updateMask.fieldPaths=uid"
                + "&updateMask.fieldPaths=email"
                + "&updateMask.fieldPaths=displayName"
                + "&updateMask.fieldPaths=provider"
                + "&updateMask.fieldPaths=lastLoginAt";

        byte[] body = document.toString().getBytes(StandardCharsets.UTF_8);
        HttpURLConnection connection = null;
        try {
            connection = (HttpURLConnection) new URL(endpoint).openConnection();
            connection.setRequestMethod("PATCH");
            connection.setConnectTimeout(12000);
            connection.setReadTimeout(15000);
            connection.setDoOutput(true);
            connection.setRequestProperty("Authorization", "Bearer " + idToken);
            connection.setRequestProperty("Content-Type", "application/json; charset=UTF-8");
            connection.setRequestProperty("Accept", "application/json");
            connection.setFixedLengthStreamingMode(body.length);

            try (OutputStream output = connection.getOutputStream()) {
                output.write(body);
                output.flush();
            }

            int status = connection.getResponseCode();
            InputStream stream = status >= 200 && status < 300
                    ? connection.getInputStream() : connection.getErrorStream();
            String responseText = readFully(stream);
            if (status < 200 || status >= 300) {
                String detail = "HTTP " + status;
                if (!responseText.isEmpty()) {
                    try {
                        JSONObject response = new JSONObject(responseText);
                        JSONObject error = response.optJSONObject("error");
                        if (error != null) detail = error.optString("status", detail)
                                + ": " + error.optString("message", "Falha no Firestore");
                    } catch (Exception ignored) { }
                }
                throw new IOException("Firestore: " + detail);
            }
        } finally {
            if (connection != null) connection.disconnect();
        }
    }
    private JSONObject refreshFirebaseToken(String refreshToken) throws Exception {
        String form = "grant_type=refresh_token&refresh_token=" + urlEncode(refreshToken);
        return postForm(TOKEN_ENDPOINT + urlEncode(apiKey), form);
    }

    private JSONObject postJson(String endpoint, JSONObject payload) throws Exception {
        byte[] body = payload.toString().getBytes(StandardCharsets.UTF_8);
        return executePost(endpoint, "application/json; charset=UTF-8", body);
    }

    private JSONObject postForm(String endpoint, String form) throws Exception {
        byte[] body = form.getBytes(StandardCharsets.UTF_8);
        return executePost(endpoint, "application/x-www-form-urlencoded; charset=UTF-8", body);
    }

    private JSONObject executePost(String endpoint, String contentType, byte[] body) throws Exception {
        HttpURLConnection connection = null;
        try {
            connection = (HttpURLConnection) new URL(endpoint).openConnection();
            connection.setRequestMethod("POST");
            connection.setConnectTimeout(15000);
            connection.setReadTimeout(20000);
            connection.setDoOutput(true);
            connection.setRequestProperty("Content-Type", contentType);
            connection.setRequestProperty("Accept", "application/json");
            connection.setFixedLengthStreamingMode(body.length);

            try (OutputStream output = connection.getOutputStream()) {
                output.write(body);
                output.flush();
            }

            int status = connection.getResponseCode();
            InputStream stream = status >= 200 && status < 300
                    ? connection.getInputStream() : connection.getErrorStream();
            String responseText = readFully(stream);
            JSONObject response = responseText.isEmpty()
                    ? new JSONObject() : new JSONObject(responseText);
            if (status < 200 || status >= 300) {
                JSONObject error = response.optJSONObject("error");
                String detail = error == null
                        ? "HTTP " + status
                        : error.optString("message", "HTTP " + status);
                throw new IOException("Firebase Auth (" + status + "): " + detail);
            }
            return response;
        } finally {
            if (connection != null) connection.disconnect();
        }
    }

    private String readFully(InputStream input) throws IOException {
        if (input == null) return "";
        try (InputStream stream = input;
             ByteArrayOutputStream output = new ByteArrayOutputStream()) {
            byte[] buffer = new byte[4096];
            int count;
            while ((count = stream.read(buffer)) != -1) {
                output.write(buffer, 0, count);
            }
            return new String(output.toByteArray(), StandardCharsets.UTF_8);
        }
    }

    private String urlEncode(String value) throws Exception {
        return URLEncoder.encode(value, "UTF-8");
    }

    private boolean isInvalidRefreshTokenError(String message) {
        String upper = message == null ? "" : message.toUpperCase();
        return upper.contains("INVALID_REFRESH_TOKEN")
                || upper.contains("TOKEN_EXPIRED")
                || upper.contains("USER_DISABLED")
                || upper.contains("USER_NOT_FOUND");
    }

    private void signOut() {
        currentIdToken = null;
        currentUid = null;
        currentEmail = null;
        currentDisplayName = null;
        sessionStore.clear();
        renderSignedOut();

        if (credentialManager == null) return;
        credentialManager.clearCredentialStateAsync(
                new ClearCredentialStateRequest(),
                null,
                mainExecutor,
                new CredentialManagerCallback<Void, ClearCredentialException>() {
                    @Override
                    public void onResult(Void result) {
                        if (!isFinishing() && !isDestroyed()) {
                            statusView.setText("Você saiu da conta DVNex.");
                        }
                    }

                    @Override
                    public void onError(ClearCredentialException error) {
                        if (!isFinishing() && !isDestroyed()) {
                            statusView.setText("Sessão DVNex encerrada. " + safeMessage(error));
                        }
                    }
                });
    }

